use sim

fn place(mut s: sim.State, x: int, y: int, heading: int) {
    s.front = 0
    s.length = 1
    s.heading = heading
    s.wolves[0] = sim.Wolf { x: x, y: y, heading: heading }
    (mut s.meat).reset()
}

fn seek_roll(mut seed: int, wanted: bool) {
    for _trial in 0..1000 {
        var probe = seed
        if sim.hits(sim.d20(mut probe)) == wanted { return }
        let _roll = sim.d20(mut seed)
    }
    assert(false, "seeded stream never produced required strike outcome")
}

fn test_wrap_all_four_edges_both_axes() {
    var s = sim.new(7, 16, 7, true)
    for y in 0..7 {
        place(mut s, 0, y, 3)
        sim.advance(mut s)
        assert(sim.wolf(s, 0).x == 15 && sim.wolf(s, 0).y == y && sim.wolf(s, 0).heading == 3)
        place(mut s, 15, y, 4)
        sim.advance(mut s)
        assert(sim.wolf(s, 0).x == 0 && sim.wolf(s, 0).y == y && sim.wolf(s, 0).heading == 4)
    }
    for x in 0..16 {
        place(mut s, x, 0, 1)
        sim.advance(mut s)
        assert(sim.wolf(s, 0).y == 6 && sim.wolf(s, 0).x == x && sim.wolf(s, 0).heading == 1)
        place(mut s, x, 6, 2)
        sim.advance(mut s)
        assert(sim.wolf(s, 0).y == 0 && sim.wolf(s, 0).x == x && sim.wolf(s, 0).heading == 2)
    }
}

fn test_reverse_refused_and_fast_double_turn_refused() {
    var s = sim.new(1, 16, 7, true)
    sim.turn(mut s, 3)
    assert(s.heading == 4)
    sim.turn(mut s, 1)
    assert(s.heading == 1)
    sim.turn(mut s, 3)
    assert(s.heading == 1)
    sim.advance(mut s)
    sim.turn(mut s, 3)
    assert(s.heading == 3)
}

fn test_summons_arrives_at_departing_tail() {
    var s = sim.new(1, 16, 7, true)
    sim.summon(mut s)
    assert(sim.pending(s) == 1 && s.length == 1)
    assert(
        s.runners[0].x < 0 ||
            s.runners[0].x >= s.cols ||
            s.runners[0].y < 0 ||
            s.runners[0].y >= s.rows,
    )
    for _tick in 0..40 { sim.step(mut s, List[int]()) }
    assert(s.length == 2 && sim.pending(s) == 0 && s.longest == 2)
    let a = sim.wolf(s, 0)
    let b = sim.wolf(s, 1)
    assert(sim.wrap(a.x - b.x, 16) == 1 && a.y == b.y)
}

fn test_running_newcomer_is_immune_to_eagle() {
    var s = sim.new(1, 16, 7, true)
    sim.summon(mut s)
    s.runners[0].age = 12
    // Find the next seeded hit without changing the strike path.
    seek_roll(mut s.roll_rng, true)
    sim.strike(mut s)
    assert(s.length == 0 && s.phase == 3 && sim.pending(s) == 1 && s.runners[0].age == 12)
}

fn test_d20_distribution_10000_seeded_strikes() {
    var seed: int = 8
    var hits: int = 0
    var bins = List[int]()
    for _n in 0..20 { (mut bins).push(0) }
    for _n in 0..10000 {
        let roll = sim.d20(mut seed)
        assert(roll >= 1 && roll <= 20)
        bins[roll - 1] += 1
        if sim.hits(roll) { hits += 1 }
    }
    print("d20: {hits}/10000 hits; expected 3350..3650; bins {bins}")
    assert(hits >= 3350 && hits <= 3650)
    for n in bins { assert(n >= 350 && n <= 650) }
    assert(sim.hits(1) && sim.hits(7) && !sim.hits(8) && !sim.hits(20))
}

fn test_pack_of_one_death_and_miss() {
    var s = sim.new(4, 16, 7, true)
    seek_roll(mut s.roll_rng, false)
    sim.strike(mut s)
    assert(s.length == 1 && s.phase == 1 && s.survived == 1 && s.score == 25)
    seek_roll(mut s.roll_rng, true)
    sim.strike(mut s)
    assert(s.length == 0 && s.phase == 3 && s.death == 2)
}

fn test_meat_eating_and_open_placement() {
    var s = sim.new(5, 16, 7, true)
    (mut s.meat).reset()
    let w = sim.wolf(s, 0)
    (mut s.meat).push(sim.Wolf { x: w.x + 1, y: w.y, heading: 0 })
    sim.advance(mut s)
    assert(s.score == 100 && s.eaten == 1 && sim.pending(s) == 1)
    for _n in 0..100 {
        sim.refill(mut s)
        for m in s.meat { assert(!sim.occupied(s, m.x, m.y)) }
        (mut s.meat).reset()
    }
    s.length = 8
    for i in 0..8 { s.wolves[(s.front + i) % s.wolves.len] = sim.Wolf { x: i, y: 0, heading: 4 } }
    sim.refill(mut s)
    assert(s.meat.len == 2)
}

fn test_pace_and_cadence_and_first_eagle() {
    assert(sim.pace(1) == 16 && sim.pace(2) == 17 && sim.pace(25) == 40 && sim.pace(100) == 40)
    var s = sim.new(5, 16, 7, true)
    for _n in 0..100 { let t = sim.interval(mut s); assert(t >= 360 && t <= 600) }
    assert(s.eagle_due == -1)
    s.length = 3
    s.wolves[1] = sim.Wolf { x: 7, y: 3, heading: 4 }
    s.wolves[2] = sim.Wolf { x: 6, y: 3, heading: 4 }
    sim.advance(mut s)
    assert(s.eagle_due >= 330 && s.eagle_due <= 570)
    s.length = 30
    for _n in 0..100 { assert(sim.interval(mut s) >= 180) }
}

fn test_telegraph_lasts_30_ticks_and_exit_18() {
    var s = sim.new(7, 16, 7, true)
    s.eagle_due = 1
    for _n in 0..29 { sim.step(mut s, List[int]()) }
    assert(s.strikes == 0 && s.eagle_age == 29)
    sim.step(mut s, List[int]())
    assert(s.strikes == 1)
    if s.phase == 1 {
        for _n in 0..18 { sim.step(mut s, List[int]()) }
        assert(s.eagle_age == -1)
    }
}

fn test_self_collision_and_departing_tail() {
    var s = sim.new(2, 16, 7, true)
    s.length = 4
    s.wolves[0] = sim.Wolf { x: 3, y: 3, heading: 1 }
    s.wolves[1] = sim.Wolf { x: 3, y: 4, heading: 1 }
    s.wolves[2] = sim.Wolf { x: 2, y: 4, heading: 4 }
    s.wolves[3] = sim.Wolf { x: 2, y: 3, heading: 2 }
    s.heading = 3
    sim.advance(mut s)
    assert(s.phase == 1)
    s.heading = 4
    sim.advance(mut s)
    assert(s.phase == 3 && s.death == 1)
}

fn test_pause_and_seed_determinism() {
    var a = sim.new(-7, 16, 7, true)
    var b = sim.new(-7, 16, 7, true)
    for _n in 0..180 { sim.step(mut a, List[int]()); sim.step(mut b, List[int]()) }
    assert(a.rng == b.rng && a.length == b.length && sim.wolf(a, 0).x == sim.wolf(b, 0).x)
    var keys = List[int]()
    (mut keys).push(5)
    sim.step(mut a, keys)
    let age = a.age
    for _n in 0..60 { sim.step(mut a, List[int]()) }
    assert(a.age == age && a.tick == 241)
}

fn test_same_tick_turn_order_and_retry() {
    var s = sim.new(7, 16, 7, true)
    var keys = List[int]()
    (mut keys).push(1)
    (mut keys).push(4)
    sim.step(mut s, keys)
    assert(s.heading == 4)
    sim.step(mut s, List[int]())
    assert(s.heading == 4)
    let tick = s.tick
    s.phase = 2
    s.score = 500
    sim.summon(mut s)
    sim.restart(mut s)
    assert(s.tick == tick && s.phase == 1 && s.score == 0 && sim.pending(s) == 0 && s.length == 1)
    let fresh = sim.new(7, 16, 7, true)
    assert(s.rng == fresh.rng && s.meat[0].x == fresh.meat[0].x && s.meat[0].y == fresh.meat[0].y)
}

fn test_card_start_keys_enter_gameplay_without_pausing() {
    for phase in [0, 2] {
        for key in [1, 2, 3, 4, 5, 8, 9] {
            var s = sim.new(7, 16, 7, false)
            s.phase = phase
            if phase == 2 { s.score = 500; s.death = 2 }
            var keys = List[int]()
            (mut keys).push(key)
            sim.step(mut s, keys)
            assert(s.phase == 1 && !s.paused && s.age == 1)
            assert(s.score == 0)
            if key >= 1 && key <= 4 {
                assert(s.heading == key && sim.wolf(s, 0).heading == key)
            }
        }
        for key in [6, 7] {
            var s = sim.new(7, 16, 7, false)
            s.phase = phase
            var keys = List[int]()
            (mut keys).push(key)
            sim.step(mut s, keys)
            assert(s.phase == phase && s.age == 0)
        }
    }
}

fn test_leg_phase_tracks_cells_not_ticks_and_pause_freezes_run_in() {
    var s = sim.new(7, 16, 7, true)
    for _tick in 0..7 { sim.step(mut s, List[int]()) }
    assert(sim.gait_distance(s, 0) == 0)
    sim.step(mut s, List[int]())
    assert(sim.gait_distance(s, 0) == 1)
    sim.summon(mut s)
    sim.step(mut s, List[int]())
    assert(s.runners[0].distance > 0)
    let runner_distance = s.runners[0].distance
    let runner_x = s.runners[0].px
    let runner_y = s.runners[0].py
    let gait = sim.gait_distance(s, 0)
    var pause = List[int]()
    (mut pause).push(5)
    sim.step(mut s, pause)
    for _tick in 0..30 { sim.step(mut s, List[int]()) }
    assert(sim.gait_distance(s, 0) == gait)
    assert(
        s.runners[0].distance == runner_distance &&
            s.runners[0].px == runner_x &&
            s.runners[0].py == runner_y,
    )
    sim.step(mut s, pause)
    for _tick in 0..30 { sim.step(mut s, List[int]()) }
    assert(s.length == 2 && sim.gait_distance(s, 1) > 0)
    let first = sim.gait_distance(s, 0)
    let second = sim.gait_distance(s, 1)
    sim.advance(mut s)
    assert(sim.gait_distance(s, 0) == first + 1 && sim.gait_distance(s, 1) == second + 1)
    // Crossing a seam is still one cell, never the whole board's width.
    place(mut s, 15, 3, 4)
    let before = sim.gait_distance(s, 0)
    sim.advance(mut s)
    assert(sim.wolf(s, 0).x == 0 && sim.gait_distance(s, 0) == before + 1)
}

fn test_runner_arrival_keeps_final_contact_phase() {
    var s = sim.new(7, 16, 7, true)
    sim.summon(mut s)
    let tail = sim.wolf(s, 0)
    s.runners[0].age = 24
    s.runners[0].px = tail.x * 256 - 128
    s.runners[0].py = tail.y * 256
    s.runners[0].distance = 896
    sim.advance(mut s)
    assert(s.length == 2 && !s.runners[0].active)
    assert(s.runners[0].distance == 1024 && sim.gait_distance(s, 1) == 4)
}


fn test_scatter_is_seeded_and_card_waits_thirty_ticks() {
    var a=sim.new(7,11,3,true); var b=sim.new(7,11,3,true)
    sim.begin_scatter(mut a,1,4,1); sim.begin_scatter(mut b,1,4,1)
    assert(a.phase==3 && a.scatter_age==0 && a.scatter_count==a.length)
    for _n in 0..29 { sim.step(mut a,List[int]()); sim.step(mut b,List[int]()) }
    assert(a.phase==3 && a.scatter_age==29)
    assert(a.scatter[0].x==b.scatter[0].x && a.scatter[0].y==b.scatter[0].y && a.scatter[0].distance==b.scatter[0].distance)
    assert(a.scatter[0].distance>0)
    sim.step(mut a,List[int]()); assert(a.phase==2 && a.scatter_age==30)
}
fn test_taken_last_wolf_is_carried_to_exit_before_card() {
    var s=sim.new(7,11,3,true)
    let w=sim.wolf(s,0); s.eagle_edge=0
    sim.begin_scatter(mut s,2,w.x,w.y); s.length=0
    let x=s.scatter[0].x
    for _n in 0..15 { sim.step(mut s,List[int]()) }
    assert(s.phase==3 && s.scatter[0].x>x)
    for _n in 0..15 { sim.step(mut s,List[int]()) }
    assert(s.phase==2 && s.scatter[0].x>=s.cols*256)
}
