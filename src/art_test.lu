use art
use grid
use sim
use sprites
use tier

fn test_wolf_body_bar_and_four_separated_leg_columns() {
    assert(sprites.CELL_SPAN == 7)
    for distance in 0..8 {
        for x in 0..7 {
            if x % 2 == 0 {
                assert(sprites.east_part(x, 2) == 4)
            } else {
                assert(sprites.east_part(x, 2) == 0)
            }
        }
        for x in 1..6 { assert(sprites.mask_at(x, 1, 4, distance) == 15) }
        assert(sprites.east_part(6, 0) == 3 && sprites.east_part(6, 1) == 2)
        assert(sprites.east_part(0, 0) == 5)
        for h in 1..5 {
            var feet = 0
            for y in 0..sprites.height(h) {
                for x in 0..sprites.width(h) {
                    if sprites.part(x, y, h) == 4 { feet += 1 }
                    assert(
                        (sprites.wolf_cell(x, y, h, distance, tier.PLAIN) == 0) ==
                            (sprites.wolf_cell(x, y, h, distance, tier.RICH) == 0),
                    )
                }
            }
            assert(feet == 4)
        }
    }
}

fn test_four_contact_frames_move_diagonal_pairs_without_hiding_feet() {
    for h in 1..5 {
        for t in 0..2 {
            for a in 0..4 {
                for b in 0..4 {
                    if a != b {
                        var changes = 0
                        for y in 0..sprites.height(h) {
                            for x in 0..sprites.width(h) {
                                if sprites.wolf_cell(x, y, h, a, t) !=
                                    sprites.wolf_cell(x, y, h, b, t) {
                                    changes += 1
                                }
                            }
                        }
                        assert(changes > 0)
                    }
                }
            }
        }
    }
    for phase in 0..4 {
        // Front-left and back-right move together; the other diagonal too.
        let a = sprites.mask_at(2, 2, 4, phase)
        let b = sprites.mask_at(0, 2, 4, phase)
        assert(a == sprites.mask_at(4, 2, 4, phase))
        assert(b == sprites.mask_at(6, 2, 4, phase))
        assert((a == 5 || a == 10) && (b == 5 || b == 10))
        assert(sprites.tail_phase(phase) == 0 && sprites.tail_phase(phase + 4) == 1)
    }
}

fn test_oriented_sprite_envelope_matches_collision_cell() {
    for h in 1..5 {
        assert(sprites.width(h) <= sprites.CELL_SPAN && sprites.height(h) <= sprites.CELL_SPAN)
    }
    assert(sprites.width(4) == 7 && sprites.height(4) == 3)
    assert(sprites.width(1) == 3 && sprites.height(1) == 7)
}

fn test_floor_is_visible_soil_with_seeded_rocks_on_both_tiers() {
    for t in 0..2 {
        let a = art.floor(7, 200, 60, t)
        let b = art.floor(8, 200, 60, t)
        var rocks = 0
        var varied = 0
        for i in 0..12000 {
            assert(a.cells[i].cp != 32)
            if a.cells[i].cp == 79 || a.cells[i].cp == 9670 { rocks += 1 }
            if !grid.same(a.cells[i], b.cells[i]) { varied += 1 }
        }
        assert(rocks > 200 && rocks < 600 && varied > 1000)
        if t == tier.PLAIN { assert(grid.plain_ok(a)) }
    }
}

fn test_frame_plain_footprints_meat_and_leader() {
    var s = sim.new(7, 11, 3, true)
    let g = art.frame(s, 80, 24, tier.PLAIN)
    assert(grid.plain_ok(g))
    var a = art.floor(7, 80, 24, tier.RICH)
    var b = art.floor(7, 80, 24, tier.RICH)
    sprites.wolf(mut a, 5, 5, 4, 0, true, false, tier.RICH)
    sprites.wolf(mut b, 5, 5, 4, 0, false, false, tier.RICH)
    assert(grid.at(a, 8, 8).fg != grid.at(b, 8, 8).fg)
    sprites.meat(mut a, 10, 10, tier.RICH)
    assert(grid.at(a, 10, 10).cp == 9608 && grid.at(a, 10, 11).fg == 196)
    s.phase = 2
    s.death = 2
    assert(grid.plain_ok(art.frame(s, 80, 24, tier.PLAIN)))
}
