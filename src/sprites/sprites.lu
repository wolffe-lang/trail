//! Seven-column body bar and four separated leg columns. The north/south
//! construction is quarter-turned, not compressed into the old blob.

use grid
use tier

/// Logical collision envelope for every heading; actual sheet is 7x3 or 3x7.
pub const CELL_SPAN: int = 7

/// Four alternating diagonal-pair contact frames, driven by distance.
pub fn leg_phase(distance: int) -> int { distance % 4 }

/// Tail sway spans two complete contact strides.
pub fn tail_phase(distance: int) -> int { distance / 4 % 2 }

/// East/west width seven, north/south width three.
pub fn width(heading: int) -> int { if heading <= 2 then 3 else 7 }

/// East/west height three, north/south height seven.
pub fn height(heading: int) -> int { if heading <= 2 then 7 else 3 }

/// East-facing part: body=1, head=2, ear-notch=3, four feet=4, tail=5.
pub fn east_part(x: int, y: int) -> int {
    if x < 0 || x > 6 || y < 0 || y > 2 { return 0 }
    if y == 0 { return if x == 0 then 5 else if x == 6 then 3 else 0 }
    if y == 1 { return if x == 6 then 2 else 1 }
    if x % 2 == 0 then 4 else 0
}

// Quadrants UL=1, UR=2, LL=4, LR=8. Legs always retain a full-height
// one-half-cell column; only their fore/aft contact changes, not visibility.
fn east_mask(x: int, y: int, distance: int) -> int {
    let kind = east_part(x, y)
    if kind == 0 { return 0 }
    if kind == 5 { return if tail_phase(distance) == 0 then 4 else 8 }
    if kind == 3 { return 14 } // forward head with an upper-left ear notch
    if y == 1 { return if x == 0 then 10 else 15 } // hip, solid bar, head
    let a = x == 2 || x == 4 // back-right + front-left, the diagonal pair
    let phase = leg_phase(distance)
    let forward = if a then phase == 1 || phase == 2 else phase == 0 || phase == 1
    if forward then 10 else 5
}

fn rotate(mask: int) -> int {
    (if mask & 1 != 0 then 2 else 0) |
        (if mask & 2 != 0 then 8 else 0) |
        (if mask & 4 != 0 then 1 else 0) |
        (if mask & 8 != 0 then 4 else 0)
}

fn mirror(mask: int) -> int {
    (if mask & 1 != 0 then 2 else 0) |
        (if mask & 2 != 0 then 1 else 0) |
        (if mask & 4 != 0 then 8 else 0) |
        (if mask & 8 != 0 then 4 else 0)
}

fn east_coordinates(x: int, y: int, heading: int) -> (int, int) {
    if heading == 1 { return (6 - y, x) }
    if heading == 2 { return (y, 2 - x) }
    if heading == 3 { return (6 - x, y) }
    (x, y)
}

/// Semantic part after the same turn/mirror as the visible cell.
pub fn part(x: int, y: int, heading: int) -> int {
    let (ex, ey) = east_coordinates(x, y, heading)
    east_part(ex, ey)
}

/// Rotated two-by-two quadrant mask, with no scale or clipped extremities.
pub fn mask_at(x: int, y: int, heading: int, distance: int) -> int {
    if x < 0 || x >= width(heading) || y < 0 || y >= height(heading) { return 0 }
    let (ex, ey) = east_coordinates(x, y, heading)
    let m = east_mask(ex, ey, distance)
    if heading == 1 { return rotate(rotate(rotate(m))) }
    if heading == 2 { return rotate(m) }
    if heading == 3 { return mirror(m) }
    m
}

fn glyph(mask: int) -> int {
    match mask {
        1 => 9624,
        2 => 9629,
        3 => 9600,
        4 => 9622,
        5 => 9612,
        6 => 9630,
        7 => 9627,
        8 => 9623,
        9 => 9626,
        10 => 9616,
        11 => 9628,
        12 => 9604,
        13 => 9625,
        14 => 9631,
        15 => 9608,
        _ => 0,
    }
}

/// Exact cell silhouette on both tiers. Plain uses # for body/planted feet,
/// | for the other contact, . for the tail; four leg columns remain visible.
pub fn wolf_cell(x: int, y: int, heading: int, distance: int, t: int) -> int {
    let m = mask_at(x, y, heading, distance)
    if m == 0 { return 0 }
    if t == tier.RICH { return glyph(m) }
    let (ex, ey) = east_coordinates(x, y, heading)
    let kind = east_part(ex, ey)
    if kind == 5 { return 46 }
    if kind == 4 { return if east_mask(ex, ey, distance) == 5 then 124 else 35 }
    35
}

/// Draw centred in a seven-by-seven logical cell; the sheet itself is 7x3
/// east/west or 3x7 north/south. Leader stays brighter/bold, newcomers gold.
pub fn wolf(
    mut g: grid.Grid,
    row: int,
    col: int,
    heading: int,
    distance: int,
    leader: bool,
    runner: bool,
    t: int,
) {
    let fg = if t == tier.PLAIN {
        if runner then 11 else if leader then 15 else 7
    } else if runner then 179 else if leader then 231 else 247
    let top = row + (CELL_SPAN - height(heading)) / 2
    let left = col + (CELL_SPAN - width(heading)) / 2
    for y in 0..height(heading) {
        for x in 0..width(heading) {
            let cp = wolf_cell(x, y, heading, distance, t)
            if cp != 0 {
                let old = grid.at(g, top + y, left + x)
                grid.put(
                    mut g,
                    top + y,
                    left + x,
                    grid.cell(cp, fg, old.bg, if leader then grid.ATTR_BOLD else 0),
                )
            }
        }
    }
}

/// Solid red two-cell meat, never a letter on the rich tier.
pub fn meat(mut g: grid.Grid, row: int, col: int, t: int) {
    for x in 0..2 {
        let old = grid.at(g, row, col + x)
        grid.put(
            mut g,
            row,
            col + x,
            grid.cell(
                if t == tier.PLAIN then 35 else 9608,
                if t == tier.PLAIN then 9 else 196,
                old.bg,
                grid.ATTR_BOLD,
            ),
        )
    }
}

/// Spread-wing eagle, seven by three, over the floor (not a cursor glyph).
pub fn eagle(mut g: grid.Grid, row: int, col: int, t: int) {
    for y in 0..3 {
        for x in 0..7 {
            let visible = y == 0 && (x == 0 || x == 6 || x == 3) ||
                y == 1 && x >= 0 && x <= 6 ||
                y == 2 && x >= 2 && x <= 4
            if visible {
                let old = grid.at(g, row + y, col + x)
                grid.put(
                    mut g,
                    row + y,
                    col + x,
                    grid.cell(
                        if t == tier.PLAIN then 35 else 9604,
                        if t == tier.PLAIN then 15 else 223,
                        old.bg,
                        grid.ATTR_BOLD,
                    ),
                )
            }
        }
    }
}

/// Dim diamond shadow. Its caller supplies a different position every tick.
pub fn shadow(mut g: grid.Grid, row: int, col: int, t: int) {
    for y in 0..3 {
        for x in 0..5 {
            if y == 1 && x >= 0 && x <= 4 || y != 1 && x == 2 {
                let old = grid.at(g, row + y, col + x)
                grid.put(
                    mut g,
                    row + y,
                    col + x,
                    grid.cell(
                        if t == tier.PLAIN then 43 else 183,
                        if t == tier.PLAIN then 8 else 240,
                        old.bg,
                        grid.ATTR_DIM,
                    ),
                )
            }
        }
    }
}
