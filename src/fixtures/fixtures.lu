//! Explicit replay scene fixtures for rare visual states, never random events.

use sim

/// Set a labelled scene (1 summons, 2 telegraph, 3 hit, 4 miss,
/// 5..8 cardinal seams, 9 death, 10 busy benchmark). Not used by live keys.
#[allow(w0314)] // One deliberate test-data boundary, not a simulation rule.
pub fn scene(mut s: sim.State, n: int) {
    s.phase = 1
    if n == 1 {
        sim.summon(mut s)
        s.runners[0].age = 12
    } else if n >= 2 && n <= 4 {
        s.length = 3
        s.longest = 3
        let head = sim.wolf(s, 0)
        for i in 1..3 {
            s.wolves[(s.front + i) % s.wolves.len] = sim.Wolf {
                x: sim.wrap(head.x - i, s.cols),
                y: head.y,
                heading: 4,
            }
        }
        sim.begin_eagle(mut s)
        if n == 2 {
            s.eagle_credit = 600
            s.eagle_age = 20
        } else {
            let tail = sim.wolf(s, s.length - 1)
            s.eagle_x = tail.x
            s.eagle_y = tail.y
            s.eagle_px = tail.x * 256
            s.eagle_py = tail.y * 256
            s.eagle_credit = 2400 - sim.pace(s.length)
            s.eagle_age = sim.approach_ticks(s.length) - 1
            s.credit = 0
        }
        if n == 3 || n == 4 {
            while true {
                var probe = s.roll_rng
                let roll = sim.d20(mut probe)
                if sim.hits(roll) == (n == 3) { break }
                let _roll = sim.d20(mut s.roll_rng)
            }
        }
    } else if n >= 5 && n <= 8 {
        let h = n - 4
        s.heading = h
        s.wolves[s.front] = sim.Wolf {
            x: if h == 3 then 0 else if h == 4 then s.cols - 1 else s.cols / 2,
            y: if h == 1 then 0 else if h == 2 then s.rows - 1 else s.rows / 2,
            heading: h,
        }
        s.credit = 119
    } else if n == 9 {
        s.length = 0
        s.phase = 2
        s.death = 2
        s.last_roll = 4
        s.rolls[0] = 4
        s.roll_count = 1
        s.strikes = 1
    } else if n == 11 {
        s.length = 4
        s.longest = 4
        s.wolves[0] = sim.Wolf { x: 2, y: 1, heading: 1 }
        s.wolves[1] = sim.Wolf { x: 1, y: 1, heading: 4 }
        s.wolves[2] = sim.Wolf { x: 1, y: 2, heading: 1 }
        s.wolves[3] = sim.Wolf { x: 2, y: 2, heading: 3 }
        s.heading = 3
        s.credit = 119
    } else if n == 12 {
        let w = sim.wolf(s, 0)
        s.eagle_edge = 0
        sim.begin_scatter(mut s, 2, w.x, w.y)
        s.length = 0
    } else if n == 10 {
        s.length = if s.cols * s.rows >= 20 then 20 else 8
        s.longest = s.length
        for i in 0..s.length {
            s.wolves[(s.front + i) % s.wolves.len] = sim.Wolf {
                x: i % s.cols,
                y: i / s.cols,
                heading: i % 4 + 1,
            }
        }
        sim.summon(mut s)
        s.runners[0].age = 12
        s.eagle_age = 15
        s.eagle_x = s.cols / 2
        s.eagle_y = s.rows / 2
    }
    sim.refill(mut s)
}
