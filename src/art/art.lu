//! Original soil: coherent earth tones under seed-scattered stones and clods.

use draw
use sim
use sprites
use grid
use tier
use world

/// Seeded soil frame. Dimensions must be positive.
pub fn floor(seed: int, cols: int, rows: int, t: int) -> grid.Grid {
    let safe_seed = seed % 2147483646
    var g = grid.new(rows, cols)
    var r = 0
    while r < rows {
        let band = world.noise(safe_seed, 17, r * 3) / 64
        var c = 0
        while c < cols {
            let h = world.hash(safe_seed, r, c, 100)
            let v = world.variant(safe_seed, r, c, 3)
            let cp = if h < 3 {
                if t == tier.PLAIN then 79 else 9670
            } else if h < 9 {
                if t == tier.PLAIN then 111 else 9642
            } else if h < 34 {
                if t == tier.PLAIN then 58 else 183
            } else {
                46
            }
            let fg = if t == tier.PLAIN {
                if h < 9 then 7 else 3
            } else if h < 9 then 137 + v else 94 + (band + v) % 3
            grid.put(mut g, r, c, grid.cell(cp, fg, if t == tier.PLAIN then 0 else 52, 0))
            c += 1
        }
        r += 1
    }
    g
}

fn text(mut g: grid.Grid, row: int, col: int, value: str, t: int, bright: bool) {
    draw.put_text(
        mut g,
        row,
        col,
        draw.fit(value, g.cols - col, false),
        grid.cell(
            32,
            if t == tier.PLAIN then 15 else 230,
            if t == tier.PLAIN then 0 else 52,
            if bright then grid.ATTR_BOLD else 0,
        ),
    )
}

fn card(mut g: grid.Grid, title: str, lines: List[str], t: int) {
    let width = if g.cols >= 64 then 62 else g.cols - 2
    let height = lines.len + 4
    let top = (g.rows - height) / 2
    let left = (g.cols - width) / 2
    let fg = if t == tier.PLAIN then 3 else 179
    let bg = if t == tier.PLAIN then 0 else 52
    draw.frame(
        mut g,
        top,
        left,
        height,
        width,
        grid.cell(if t == tier.PLAIN then 45 else 9472, fg, bg, 0),
        grid.cell(if t == tier.PLAIN then 45 else 9472, fg, bg, 0),
        grid.cell(if t == tier.PLAIN then 124 else 9474, fg, bg, 0),
        grid.cell(32, fg, bg, 0),
    )
    text(mut g, top + 1, left + 3, draw.fit(title, width - 6, false), t, true)
    var i = 0
    while i < lines.len {
        text(mut g, top + 3 + i, left + 3, draw.fit(lines[i], width - 6, false), t, false)
        i += 1
    }
}

/// Frame from pure simulation. A logical cell is seven columns by seven rows;
/// resizing changes only centring, never the board or seeded rules.
pub fn frame(s: sim.State, cols: int, rows: int, t: int) -> grid.Grid {
    var g = floor(s.seed, cols, rows, t)
    let left = (cols - s.cols * sprites.CELL_SPAN) / 2
    let top = 1 + (rows - 2 - s.rows * sprites.CELL_SPAN) / 2
    for m in s.meat {
        sprites.meat(
            mut g,
            top + m.y * sprites.CELL_SPAN + 3,
            left + m.x * sprites.CELL_SPAN + 2,
            t,
        )
    }
    if s.eagle_age >= 0 && s.length > 0 {
        let target_x = left + s.eagle_x * sprites.CELL_SPAN + sprites.CELL_SPAN / 2 - 2
        let target_y = top + s.eagle_y * sprites.CELL_SPAN + sprites.CELL_SPAN / 2 - 1
        let start_x = if s.eagle_edge == 0 {
            -8
        } else if s.eagle_edge == 1 {
            cols + 7
        } else {
            target_x
        }
        let start_y = if s.eagle_edge == 2 {
            -4
        } else if s.eagle_edge == 3 {
            rows + 3
        } else {
            target_y
        }
        var x = target_x
        var y = target_y
        if s.eagle_age < 30 {
            x = start_x + (target_x - start_x) * s.eagle_age / 30
            y = start_y + (target_y - start_y) * s.eagle_age / 30
        } else {
            let away_x = if s.eagle_edge == 0 {
                cols + 8
            } else if s.eagle_edge == 1 {
                -8
            } else {
                target_x
            }
            let away_y = if s.eagle_edge == 2 {
                rows + 4
            } else if s.eagle_edge == 3 {
                -4
            } else {
                target_y
            }
            x += (away_x - target_x) * (s.eagle_age - 30) / 18
            y += (away_y - target_y) * (s.eagle_age - 30) / 18
        }
        sprites.shadow(mut g, y, x, t)
        sprites.eagle(mut g, y - 3, x - 1, t)
    }
    var i = if s.death==0 then s.length-1 else -1
    while i >= 0 {
        let w = sim.wolf(s, i)
        sprites.wolf(
            mut g,
            top + w.y * sprites.CELL_SPAN,
            left + w.x * sprites.CELL_SPAN,
            if i == 0 then s.heading else w.heading,
            sim.gait_distance(s, i),
            i == 0,
            false,
            t,
        )
        i -= 1
    }
    if s.length>0 && s.death==0 {
        let tail = sim.wolf(s, s.length - 1)
        for r in s.runners {
            if r.active {
                let x = r.px * sprites.CELL_SPAN / 256
                let y = r.py * sprites.CELL_SPAN / 256
                let heading = if tail.x * 256 > r.px {
                    4
                } else if tail.x * 256 < r.px {
                    3
                } else if tail.y * 256 > r.py {
                    2
                } else {
                    1
                }
                sprites.wolf(mut g, top + y, left + x, heading, r.distance / 256, false, true, t)
            }
        }
    }
    for k in 0..s.scatter_count {
        let w=copy s.scatter[k]
        let x=left+w.x*sprites.CELL_SPAN/256
        let y=top+w.y*sprites.CELL_SPAN/256
        sprites.wolf(mut g,y,x,w.heading,w.distance/256,k==0,false,t)
        if s.death==2 { sprites.eagle(mut g,y-1,x,t) }
    }
    let bg = if t == tier.PLAIN then 0 else 52
    draw.fill(mut g, 0, 0, 1, cols, grid.cell(32, 7, bg, 0))
    let roll = if s.last_roll == 0 {
        "eagle: --/20 (35%; hit 1-7)"
    } else {
        "eagle: {s.last_roll}/20 {if sim.hits(s.last_roll) then "HIT" else "miss"} (35%; hit 1-7)"
    }
    let hud = if cols < 80 {
        "35% <=7 d20:{if s.last_roll == 0 then "--" else "{s.last_roll}"} {if s.last_roll == 0 then "" else if sim.hits(s.last_roll) then "HIT" else "miss"} P{s.length} S{s.score} E{s.survived}"
    } else {
        "pack {s.length}  score {s.score}  survived {s.survived}  {roll}"
    }
    text(mut g,0,1,if s.phase==3 then (if s.death==1 then "the pack scatters" else "the eagle carries the last wolf") else hud,t,true)
    draw.fill(mut g, rows - 1, 0, 1, cols, grid.cell(32, 7, bg, 0))
    text(
        mut g,
        rows - 1,
        1,
        if s.paused {
            "PAUSED  Space resumes | q quits"
        } else {
            "Arrows turn | Space pauses | q quits"
        },
        t,
        false,
    )
    if s.phase == 0 {
        card(
            mut g,
            "T R A I L",
            [
                "One wolf. A meal. A longer trail.",
                "The eagle rolls a d20: 1-7 takes the tail.",
                "The four edges are paths, not walls.",
                "Enter or any key to run. q / Esc quits.",
                "q / Esc leaves the trail.",
            ],
            t,
        )
    } else if s.phase == 2 {
        let cause = if s.death == 1 {
            "The trail crossed itself. The pack scattered."
        } else {
            "The eagle took the last wolf."
        }
        var history = ""
        let first = if s.roll_count > 16 then s.roll_count - 16 else 0
        var n = first
        while n < s.roll_count { history += " {s.rolls[n % 16]}"; n += 1 }
        card(
            mut g,
            "THE TRAIL ENDS",
            [
                cause,
                "Score {s.score}   Longest trail {s.longest}",
                "Eagles survived {s.survived} / {s.strikes} strikes",
                "Last 16 rolls:{history}",
                "Enter or any key retries. q / Esc quits.",
            ],
            t,
        )
    }
    g
}

/// Clear contact study for one heading: four phases across, opposite tail
/// sway below, with uncluttered floor showing between every limb column.
pub fn study(seed: int, cols: int, rows: int, t: int, heading: int) -> grid.Grid {
    var g = floor(seed, cols, rows, t)
    text(mut g, 0, 1, "TRAIL / four separate legs / H{heading} / {tier.name(t)}", t, true)
    for f in 0..4 {
        let x = 3 + f * 18
        text(mut g, 2, x, "phase {f}", t, false)
        text(mut g, 12, x, "tail other side", t, false)
        for top in [3, 13] {
            draw.fill(
                mut g,
                top,
                x - 1,
                8,
                9,
                grid.cell(
                    if t == tier.PLAIN then 46 else 183,
                    if t == tier.PLAIN then 3 else 94,
                    if t == tier.PLAIN then 0 else 52,
                    0,
                ),
            )
        }
        sprites.wolf(mut g, 3, x, heading, f, f == 0, f == 3, t)
        sprites.wolf(mut g, 13, x, heading, f + 4, false, false, t)
    }
    g
}

/// Props companion for each tier/size, separate from the enlarged wolf sheet.
pub fn study_props(seed: int, cols: int, rows: int, t: int) -> grid.Grid {
    var g = floor(seed, cols, rows, t)
    text(mut g, 1, 2, "TRAIL / meat, eagle and sliding shadow / {tier.name(t)}", t, true)
    text(mut g, 5, 2, "meat       eagle          shadow", t, false)
    sprites.meat(mut g, 8, 3, t)
    sprites.eagle(mut g, 8, 16, t)
    sprites.shadow(mut g, 9, 34, t)
    g
}
