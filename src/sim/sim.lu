//! Seeded rules only: no terminal, environment or clock. A bounded ring deque
//! stores wolves; a runner becomes a deque member only on a movement boundary.

use input

/// A grid position and direction (1 north, 2 south, 3 west, 4 east).
pub struct Wolf { x: int, y: int, heading: int }

/// One meal's summoned wolf, interpolated from an edge toward the moving tail.
pub struct Runner { x: int, y: int, age: int, active: bool, px: int, py: int, distance: int }

/// One scattered/captured wolf, positions in 1/256 cells.
pub struct ScatterWolf {
    x: int,
    y: int,
    start_x: int,
    start_y: int,
    heading: int,
    speed: int,
    distance: int,
}

/// Death animation duration after the first visible scatter frame.
pub const SCATTER_TICKS: int = 30

/// A reproducible run. Storage is allocated once and bounded by field area.
pub struct State {
    seed: int,
    rng: int,
    roll_rng: int,
    cols: int,
    rows: int,
    wolves: List[Wolf],
    gaits: List[int],
    scatter: List[ScatterWolf],
    scatter_count: int,
    scatter_age: int,
    front: int,
    length: int,
    heading: int,
    runners: List[Runner],
    meat: List[Wolf],
    holds: List[input.Hold],
    tick: int,
    age: int,
    phase: int,
    paused: bool,
    credit: int,
    score: int,
    longest: int,
    eaten: int,
    survived: int,
    strikes: int,
    eagle_due: int,
    eagle_age: int,
    eagle_edge: int,
    eagle_x: int,
    eagle_y: int,
    eagle_px: int,
    eagle_py: int,
    eagle_start_x: int,
    eagle_start_y: int,
    eagle_credit: int,
    eagle_distance: int,
    eagle_loiter: int,
    eagle_span: int,
    eagle_axis: int,
    eagle_dir: int,
    eagle_exit_age: int,
    eagle_exit_pace: int,
    dodges: int,
    caught: int,
    last_dodged: bool,
    carried: bool,
    taken: Wolf,
    taken_gait: int,
    last_roll: int,
    result_age: int,
    rolls: List[int],
    roll_count: int,
    death: int,
    wraps: List[int],
}

/// Park–Miller stream, arithmetic fits signed 64 bits. Returns 1..2147483646.
pub fn random(mut seed: int) -> int {
    seed = seed * 48271 % 2147483647
    seed
}

/// Unbiased d20 via rejection of the six unused generator outcomes.
pub fn d20(mut seed: int) -> int {
    var value = random(mut seed)
    while value > 2147483640 { value = random(mut seed) }
    (value - 1) % 20 + 1
}

/// 35 percent, forever: no length or score modifies this threshold.
pub fn hits(roll: int) -> bool { roll >= 1 && roll <= 7 }

/// Euclidean wrapping, keeping the heading and the other coordinate.
pub fn wrap(value: int, span: int) -> int { (value % span + span) % span }

/// Read the ith wolf from the leader (0); traps on an invalid index.
pub fn wolf(s: State, i: int) -> Wolf {
    assert(i >= 0 && i < s.length, "wolf index")
    copy s.wolves[(s.front + i) % s.wolves.len]
}

/// Whether a wolf occupies this logical cell.
pub fn occupied(s: State, x: int, y: int) -> bool {
    var i = 0
    while i < s.length {
        let w = wolf(s, i)
        if w.x == x && w.y == y { return true }
        i += 1
    }
    false
}

/// Speed in quarter-cells per second: four initially, +0.25/wolf, cap ten.
pub fn pace(length: int) -> int { if length >= 25 then 40 else 16 + length - 1 }

/// Seeded cadence, seconds, shrinking once per three wolves, floor six.
pub fn interval(mut s: State) -> int {
    let base = 12 + random(mut s.rng) % 9 - s.length / 3
    (if base < 6 then 6 else base) * 30
}

fn meat_at(s: State, x: int, y: int) -> bool {
    for m in s.meat { if m.x == x && m.y == y { return true } }
    false
}

/// Place the required meat only in open cells; full boards contain none.
pub fn refill(mut s: State) {
    let wanted = if s.length >= 8 then 2 else 1
    while s.meat.len > wanted { let _old = (mut s.meat).pop() else Wolf { x: 0, y: 0, heading: 0 } }
    while s.meat.len < wanted && s.meat.len + s.length < s.cols * s.rows {
        let start = random(mut s.rng) % (s.cols * s.rows)
        var i = 0
        var placed = false
        while i < s.cols * s.rows && !placed {
            let n = (start + i) % (s.cols * s.rows)
            let x = n % s.cols
            let y = n / s.cols
            if !occupied(s, x, y) && !meat_at(s, x, y) {
                (mut s.meat).push(Wolf { x: x, y: y, heading: 0 })
                placed = true
            }
            i += 1
        }
        if !placed { break }
    }
}

/// New run; logical dimensions must be >= 2 and the area <= 4096.
pub fn new(seed: int, cols: int, rows: int, playing: bool) -> State {
    assert(cols >= 2 && rows >= 2 && cols * rows <= 4096, "field dimensions")
    let normalized = wrap(seed, 2147483646) + 1
    var wolves = List[Wolf]()
    var gaits = List[int]()
    var scatter = List[ScatterWolf]()
    var runners = List[Runner]()
    var holds = List[input.Hold]()
    var rolls = List[int]()
    var wraps = List[int]()
    var i = 0
    while i < cols * rows {
        (mut wolves).push(Wolf { x: cols / 2, y: rows / 2, heading: 4 })
        (mut runners).push(Runner { x: 0, y: 0, age: 0, active: false, px: 0, py: 0, distance: 0 })
        (mut gaits).push(0)
        (mut scatter).push(ScatterWolf {
            x: 0,
            y: 0,
            start_x: 0,
            start_y: 0,
            heading: 4,
            speed: 0,
            distance: 0,
        })
        i += 1
    }
    for _k in 0..4 { (mut holds).push(input.hold_new()); (mut wraps).push(0) }
    for _k in 0..16 { (mut rolls).push(0) }
    var s = State {
        seed: seed,
        rng: normalized,
        roll_rng: normalized,
        cols: cols,
        rows: rows,
        wolves: wolves,
        gaits: gaits,
        scatter: scatter,
        scatter_count: 0,
        scatter_age: 0,
        front: 0,
        length: 1,
        heading: 4,
        runners: runners,
        meat: List[Wolf](),
        holds: holds,
        tick: 0,
        age: 0,
        phase: if playing then 1 else 0,
        paused: false,
        credit: 0,
        score: 0,
        longest: 1,
        eaten: 0,
        survived: 0,
        strikes: 0,
        eagle_due: -1,
        eagle_age: -1,
        eagle_edge: 0,
        eagle_x: 0,
        eagle_y: 0,
        eagle_px: 0,
        eagle_py: 0,
        eagle_start_x: 0,
        eagle_start_y: 0,
        eagle_credit: 0,
        eagle_distance: 0,
        eagle_loiter: 0,
        eagle_span: 256,
        eagle_axis: 0,
        eagle_dir: 1,
        eagle_exit_age: -1,
        eagle_exit_pace: 16,
        dodges: 0,
        caught: 0,
        last_dodged: false,
        carried: false,
        taken: Wolf { x: 0, y: 0, heading: 4 },
        taken_gait: 0,
        last_roll: 0,
        result_age: 0,
        rolls: rolls,
        roll_count: 0,
        death: 0,
        wraps: wraps,
    }
    (mut s.meat).reserve(2)
    refill(mut s)
    s
}

/// Add a runner off one of four seeded edges; never a reapable pack member.
pub fn summon(mut s: State) {
    var i = 0
    while i < s.runners.len {
        if !s.runners[i].active {
            let edge = random(mut s.rng) % 4
            let x = random(mut s.rng) % s.cols
            let y = random(mut s.rng) % s.rows
            s.runners[i] = Runner {
                x: if edge == 0 then -2 else if edge == 1 then s.cols + 1 else x,
                y: if edge == 2 then -2 else if edge == 3 then s.rows + 1 else y,
                age: 0,
                active: true,
                px: (if edge == 0 then -2 else if edge == 1 then s.cols + 1 else x) * 256,
                py: (if edge == 2 then -2 else if edge == 3 then s.rows + 1 else y) * 256,
                distance: 0,
            }
            return
        }
        i += 1
    }
}

/// Count the running newcomers separately from the reapable deque.
pub fn pending(s: State) -> int {
    var n = 0
    for r in s.runners { if r.active { n += 1 } }
    n
}

/// Turn immediately, rejecting reverse even when keys repeat; at most one
/// corner per movement boundary prevents two fast turns reversing into self.
pub fn turn(mut s: State, heading: int) {
    if heading < 1 || heading > 4 { return }
    let current = wolf(s, 0).heading
    let opposite = if current == 1 {
        2
    } else if current == 2 {
        1
    } else if current == 3 {
        4
    } else {
        3
    }
    if heading != opposite { s.heading = heading }
}

/// One cell movement. The departing tail is legal to enter unless a ready
/// newcomer grows into it on this movement; joining never duplicates a cell.
pub fn advance(mut s: State) {
    if s.phase != 1 { return }
    let old = wolf(s, 0)
    let tail = wolf(s, s.length - 1)
    var join = -1
    var j = 0
    while j < s.runners.len {
        if s.runners[j].active && s.runners[j].age >= 24 && join < 0 && s.length < s.wolves.len {
            join = j
        }
        j += 1
    }
    let raw_x = old.x + (if s.heading == 4 then 1 else if s.heading == 3 then -1 else 0)
    let raw_y = old.y + (if s.heading == 2 then 1 else if s.heading == 1 then -1 else 0)
    let x = wrap(raw_x, s.cols)
    let y = wrap(raw_y, s.rows)
    var i = 0
    let count = if join >= 0 then s.length else s.length - 1
    while i < count {
        let w = wolf(s, i)
        if x == w.x && y == w.y {
            begin_scatter(mut s, 1, x, y)
            return
        }
        i += 1
    }
    if raw_x < 0 { s.wraps[2] += 1 }
    if raw_x >= s.cols { s.wraps[3] += 1 }
    if raw_y < 0 { s.wraps[0] += 1 }
    if raw_y >= s.rows { s.wraps[1] += 1 }
    for k in 0..s.length { s.gaits[k] += 1 }
    s.front = wrap(s.front - 1, s.wolves.len)
    s.wolves[s.front] = Wolf { x: x, y: y, heading: s.heading }
    if join >= 0 {
        s.runners[join].distance += magnitude(tail.x * 256 - s.runners[join].px) +
            magnitude(tail.y * 256 - s.runners[join].py)
        s.gaits[s.length] = s.runners[join].distance / 256
        s.length += 1
        s.runners[join].active = false
        s.wolves[(s.front + s.length - 1) % s.wolves.len] = tail
        if s.length > s.longest { s.longest = s.length }
    }
    i = 0
    while i < s.meat.len {
        if s.meat[i].x == x && s.meat[i].y == y {
            s.score += 100
            s.eaten += 1
            summon(mut s)
            s.meat[i] = copy s.meat[s.meat.len - 1]
            let _m = (mut s.meat).pop() else Wolf { x: 0, y: 0, heading: 0 }
        } else {
            i += 1
        }
    }
    refill(mut s)
    if s.length >= 3 && s.eagle_due < 0 && s.eagle_age < 0 { s.eagle_due = s.age + interval(mut s) }
}

/// A roll is drawn only for a positional catch. A dodge consumes no RNG.
pub fn roll_for_catch(mut seed: int, caught: bool) -> int {
    if !caught { return 0 }
    d20(mut seed)
}

/// Resolve impact against a frozen aim cell, never chasing a dodged tail.
pub fn strike(mut s: State) {
    if s.phase != 1 { return }
    let tail = wolf(s, s.length - 1)
    let caught = tail.x == s.eagle_x && tail.y == s.eagle_y
    s.last_roll = roll_for_catch(mut s.roll_rng, caught)
    s.last_dodged = !caught
    s.strikes += 1
    s.result_age = 45
    s.eagle_exit_age = 0
    s.eagle_credit = 0
    s.eagle_exit_pace = pace(s.length)
    if !caught {
        s.dodges += 1
        s.survived += 1
        s.score += 25
    } else {
        s.caught += 1
        s.rolls[s.roll_count % 16] = s.last_roll
        s.roll_count += 1
        if hits(s.last_roll) {
            s.carried = true
            s.taken = copy tail
            s.taken_gait = s.gaits[s.length - 1]
            if s.length == 1 { begin_scatter(mut s, 2, tail.x, tail.y) }
            s.length -= 1
        } else {
            s.survived += 1
            s.score += 25
        }
    }
    s.eagle_due = s.age + interval(mut s)
    refill(mut s)
}

/// A twelve-cell 60%-speed approach lasts these ticks at a fixed length.
/// Even at maximum pace, two seconds elapse after the first visible frame.
pub fn approach_ticks(length: int) -> int { (2400 + pace(length) - 1) / pace(length) }

fn projected_tail(s: State) -> Wolf {
    // Private scratch simulation uses the same pack-movement helper, seed and
    // pending arrivals. No clock, future key assumptions or extra roll stream.
    region forecast {
        var model = copy s
        model.eagle_age = 0
        var flight = 0
        while flight < 2400 && model.phase == 1 {
            model.age += 1
            advance_pack(mut model)
            flight += pace(model.length)
        }
        wolf(model, model.length - 1)
    }
}

/// Launch visibly on the nearest seeded edge, aiming at the projected tail
/// if current heading, length and pace persist. The aim is never retargeted.
pub fn begin_eagle(mut s: State) {
    let toss = random(mut s.rng)
    let aim = projected_tail(s)
    s.eagle_x = aim.x
    s.eagle_y = aim.y
    var best = 100000
    var edge = 0
    for j in 0..4 {
        let e = (j + toss % 4) % 4
        let d = if e == 0 {
            aim.x
        } else if e == 1 {
            s.cols - 1 - aim.x
        } else if e == 2 {
            aim.y
        } else {
            s.rows - 1 - aim.y
        }
        if d < best { best = d; edge = e }
    }
    s.eagle_edge = edge
    let x = if edge == 0 then 0 else if edge == 1 then s.cols - 1 else aim.x
    let y = if edge == 2 then 0 else if edge == 3 then s.rows - 1 else aim.y
    s.eagle_start_x = x * 256
    s.eagle_start_y = y * 256
    s.eagle_px = x * 256
    s.eagle_py = y * 256
    s.eagle_axis = if edge < 2 then 1 else 0
    let at = if s.eagle_axis == 0 then x else y
    let extent = if s.eagle_axis == 0 then s.cols else s.rows
    s.eagle_dir = if at < extent - 1 - at then 1 else -1
    s.eagle_span = (if s.eagle_dir == 1 then extent - 1 - at else at) * 256
    s.eagle_loiter = 12 * 256 - best * 256
    s.eagle_credit = 0
    s.eagle_distance = 0
    s.eagle_age = 0
    s.eagle_exit_age = -1
    s.carried = false
}

fn triangle(distance: int, span: int) -> int {
    if span <= 0 { return 0 }
    let phase = distance % (span * 2)
    if phase <= span then phase else span * 2 - phase
}

fn loiter_offset(distance: int, budget: int, span: int) -> int {
    let whole = budget / (2 * span) * (2 * span)
    if distance < whole { return triangle(distance, span) }
    triangle(distance - whole, (budget - whole) / 2)
}

fn exit_eagle(mut s: State) {
    let before = s.eagle_credit * 256 / 200
    s.eagle_credit += if s.length > 0 then pace(s.length) else s.eagle_exit_pace
    let delta = s.eagle_credit * 256 / 200 - before
    if s.eagle_edge == 0 { s.eagle_px += delta }
    if s.eagle_edge == 1 { s.eagle_px -= delta }
    if s.eagle_edge == 2 { s.eagle_py += delta }
    if s.eagle_edge == 3 { s.eagle_py -= delta }
    s.eagle_distance += delta
    s.eagle_exit_age += 1
    if s.eagle_px < -256 ||
        s.eagle_px > s.cols * 256 ||
        s.eagle_py < -256 ||
        s.eagle_py > s.rows * 256 {
        s.eagle_age = -1
        s.eagle_exit_age = -1
        s.carried = false
    }
}

fn fly_eagle(mut s: State) {
    s.eagle_age += 1
    if s.eagle_exit_age >= 0 { exit_eagle(mut s); return }
    s.eagle_credit += pace(s.length)
    let d = if s.eagle_credit >= 2400 then 3072 else s.eagle_credit * 256 / 200
    s.eagle_distance = d
    if d < s.eagle_loiter {
        let along = loiter_offset(d, s.eagle_loiter, s.eagle_span) * s.eagle_dir
        s.eagle_px = s.eagle_start_x + (if s.eagle_axis == 0 then along else 0)
        s.eagle_py = s.eagle_start_y + (if s.eagle_axis == 1 then along else 0)
    } else {
        let remaining = d - s.eagle_loiter
        let dx = s.eagle_x * 256 - s.eagle_start_x
        let dy = s.eagle_y * 256 - s.eagle_start_y
        s.eagle_px = s.eagle_start_x +
            (if dx < 0 then -remaining else if dx > 0 then remaining else 0)
        s.eagle_py = s.eagle_start_y +
            (if dy < 0 then -remaining else if dy > 0 then remaining else 0)
    }
    if s.eagle_credit >= 2400 {
        s.eagle_px = s.eagle_x * 256
        s.eagle_py = s.eagle_y * 256
        strike(mut s)
    }
}

/// Pure tick over state and this tick's key stream; pause stops gameplay
/// time, not replay time. Holds derive only from tick-stamped autorepeats.
pub fn step(mut s: State, keys: List[int]) {
    for key in keys {
        if key == 6 || key == 7 { s.tick += 1; return }
    }
    var pressed = 0
    for key in keys {
        if (s.phase == 0 || s.phase == 2) && (key >= 1 && key <= 5 || key == 8 || key == 9) {
            if s.phase == 2 { restart(mut s) } else { s.phase = 1 }
            if key >= 1 && key <= 4 {
                // The first heading is a choice, not a reversal into a pack.
                s.heading = key
                s.wolves[s.front].heading = key
            }
            // The Space which dismisses a card must not immediately pause.
            if key == 5 { continue }
        }
        if key == 5 && s.phase == 1 { s.paused = !s.paused }
        if key >= 1 && key <= 4 && s.phase == 1 {
            input.hold_press(mut s.holds[key - 1], s.tick)
            turn(mut s, key)
            pressed = key
        }
    }
    if s.phase == 3 {
        scatter_step(mut s)
        s.tick += 1
        return
    }
    if s.phase == 1 && !s.paused {
        // A retired older hold must not undo a newer latched corner.
        var latest = s.holds[s.heading - 1].last
        var wanted = s.heading
        var i = 0
        while i < 4 {
            if input.held(s.holds[i], s.tick) && s.holds[i].last > latest {
                latest = s.holds[i].last
                wanted = i + 1
            }
            i += 1
        }
        if pressed == 0 && wanted != 0 { turn(mut s, wanted) }
        s.age += 1
        if s.result_age > 0 { s.result_age -= 1 }
        advance_pack(mut s)
        if s.phase == 1 {
            if s.eagle_age >= 0 {
                fly_eagle(mut s)
            } else if s.eagle_due >= 0 && s.age >= s.eagle_due {
                begin_eagle(mut s)
            }
        }
    }
    s.tick += 1
}

/// Retry the same seed, retaining bounded storage and the replay's tick count.
pub fn restart(mut s: State) {
    s.rng = wrap(s.seed, 2147483646) + 1
    s.roll_rng = s.rng
    s.front = 0
    s.length = 1
    s.heading = 4
    s.wolves[0] = Wolf { x: s.cols / 2, y: s.rows / 2, heading: 4 }
    for i in 0..s.runners.len { s.runners[i].active = false; s.gaits[i] = 0 }
    for i in 0..4 { s.holds[i] = input.hold_new(); s.wraps[i] = 0 }
    (mut s.meat).reset()
    s.age = 0
    s.phase = 1
    s.paused = false
    s.credit = 0
    s.score = 0
    s.longest = 1
    s.eaten = 0
    s.survived = 0
    s.strikes = 0
    s.eagle_due = -1
    s.eagle_age = -1
    s.last_roll = 0
    s.dodges = 0
    s.caught = 0
    s.last_dodged = false
    s.carried = false
    s.eagle_credit = 0
    s.eagle_distance = 0
    s.eagle_exit_age = -1
    s.result_age = 0
    s.roll_count = 0
    s.death = 0
    s.scatter_count = 0
    s.scatter_age = 0
    refill(mut s)
}

fn magnitude(value: int) -> int { if value < 0 then -value else value }

// Positions in 1/256 logical cells. Gait counts actual travelled distance,
// not elapsed animation ticks; a moving tail may change the approach line.
fn run_in(mut s: State) {
    let tail = wolf(s, s.length - 1)
    for i in 0..s.runners.len {
        if s.runners[i].active {
            let progress = if s.runners[i].age > 24 then 24 else s.runners[i].age
            let x = s.runners[i].x * 256 + (tail.x - s.runners[i].x) * 256 * progress / 24
            let y = s.runners[i].y * 256 + (tail.y - s.runners[i].y) * 256 * progress / 24
            s.runners[i].distance += magnitude(x - s.runners[i].px) + magnitude(y - s.runners[i].py)
            s.runners[i].px = x
            s.runners[i].py = y
        }
    }
}

/// Wolf i's distance in cells; only an accepted movement advances the gait.
/// Newcomers retain their accumulated approach distance when they join.
pub fn gait_distance(s: State, i: int) -> int {
    assert(i >= 0 && i < s.length, "gait index")
    s.gaits[i]
}

/// Start a seeded one-second scatter (cause 1) or carry-away (cause 2).
/// Stop at field bounds instead of wrapping; the leader participates too.
pub fn begin_scatter(mut s: State, cause: int, cx: int, cy: int) {
    s.death = cause
    s.phase = 3
    s.scatter_age = 0
    s.scatter_count = if cause == 2 then 1 else s.length
    for i in 0..s.scatter_count {
        let w = wolf(s, i)
        let dx = w.x - cx
        let dy = w.y - cy
        let toss = random(mut s.rng)
        var h = if magnitude(dx) > magnitude(dy) ||
            magnitude(dx) == magnitude(dy) && toss % 2 == 0 {
            if dx < 0 then 3 else 4
        } else if dy < 0 then 1 else 2
        if dx == 0 && dy == 0 { h = toss % 4 + 1 }
        if cause == 2 {
            h = if s.eagle_edge == 0 {
                4
            } else if s.eagle_edge == 1 {
                3
            } else if s.eagle_edge == 2 {
                2
            } else {
                1
            }
        }
        s.scatter[i] = ScatterWolf {
            x: w.x * 256,
            y: w.y * 256,
            start_x: w.x * 256,
            start_y: w.y * 256,
            heading: h,
            speed: 4 + toss % 4,
            distance: s.gaits[i] * 256,
        }
    }
    if cause == 2 {
        s.eagle_px = s.scatter[0].x
        s.eagle_py = s.scatter[0].y
        s.eagle_credit = 0
        s.eagle_exit_age = 0
        s.eagle_exit_pace = pace(s.length)
    }
    if SCATTER_TICKS == 0 { s.phase = 2 }
}

fn clamp(value: int, lo: int, hi: int) -> int {
    if value < lo then lo else if value > hi then hi else value
}

fn scatter_step(mut s: State) {
    s.scatter_age += 1
    if s.death == 2 { exit_eagle(mut s) }
    for i in 0..s.scatter_count {
        let w = copy s.scatter[i]
        var x = w.x
        var y = w.y
        if s.death == 2 {
            x = s.eagle_px
            y = s.eagle_py
        } else {
            let step = w.speed * 256 / 30
            x = clamp(
                w.x + (if w.heading == 4 then step else if w.heading == 3 then -step else 0),
                0,
                (s.cols - 1) * 256,
            )
            y = clamp(
                w.y + (if w.heading == 2 then step else if w.heading == 1 then -step else 0),
                0,
                (s.rows - 1) * 256,
            )
            s.scatter[i].distance += magnitude(x - w.x) + magnitude(y - w.y)
        }
        s.scatter[i].x = x
        s.scatter[i].y = y
    }
    if s.scatter_age >= SCATTER_TICKS { s.phase = 2 }
}

fn advance_pack(mut s: State) {
    for i in 0..s.runners.len { if s.runners[i].active { s.runners[i].age += 1 } }
    s.credit += pace(s.length)
    if s.credit >= 120 { s.credit -= 120; advance(mut s) }
    if s.phase == 1 { run_in(mut s) }
}
